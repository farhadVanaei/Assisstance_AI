# --- Ollama ---
OLLAMA_HOST=http://127.0.0.1:11434
JAVAD_OLLAMA_MODEL=llama3.2
JAVAD_OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Storage ---
JAVAD_DATA_DIR=./backend/data
JAVAD_SQLITE_PATH=./backend/data/javad.db
JAVAD_CHROMA_PATH=./backend/data/chroma
JAVAD_CHROMA_COLLECTION=javad_chunks

# --- Retrieval ---
JAVAD_CHUNK_MAX_LEN=600
JAVAD_CHUNK_OVERLAP=80
JAVAD_RETRIEVAL_TOP_K=5
JAVAD_RETRIEVAL_CANDIDATES=20
JAVAD_RELEVANCE_THRESHOLD=0.18
# 0 = no expiry; set e.g. 30 for 30-day TTL on web knowledge
JAVAD_KNOWLEDGE_TTL_DAYS=0

# --- Auth / CORS (leave API key empty for open local mode) ---
JAVAD_API_KEY=
JAVAD_AUTH_REQUIRED=false
JAVAD_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Set true only for local dev if needed
JAVAD_CORS_ALLOW_ALL=false

# --- Uploads / rate limits ---
JAVAD_MAX_UPLOAD_BYTES=26214400
JAVAD_RATE_LIMIT_UPLOAD=10/minute
JAVAD_RATE_LIMIT_SCRAPE=5/minute
JAVAD_RATE_LIMIT_CHAT=60/minute

# --- Language (fa remains default) ---
JAVAD_DEFAULT_LANGUAGE=fa

# --- Voice (optional) ---
JAVAD_VOICE_ENABLED=true
JAVAD_WHISPER_MODEL=base
# Path to a Piper .onnx voice model (leave empty to disable TTS)
JAVAD_PIPER_MODEL=voices/fa_IR-amir-medium.onnx
